datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           Int           @id @default(autoincrement())
  email        String        @unique @db.VarChar(191)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  name         String        @db.VarChar(100)
  role         String        @default("ADMIN") @db.VarChar(50)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  activityLogs ActivityLog[]

  @@map("admins")
}

model Agent {
  id              Int           @id @default(autoincrement())
  name            String        @db.VarChar(100)
  email           String        @unique @db.VarChar(191)
  phone           String?       @db.VarChar(50)
  status          String        @default("ACTIVE") @db.VarChar(20)
  defaultTimezone String        @default("America/New_York") @map("default_timezone") @db.VarChar(50)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  bookings        Booking[]
  bookingLinks    BookingLink[]

  @@map("agents")
}

model BookingLink {
  id          Int       @id @default(autoincrement())
  token       String    @unique @db.VarChar(64)
  agentId     Int?      @map("agent_id")
  name        String    @db.VarChar(100)
  isActive    Boolean   @default(true) @map("is_active")
  clicksCount Int       @default(0) @map("clicks_count")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  bookings    Booking[]

  @@index([agentId])
  @@map("booking_links")
}

model CalendarSettings {
  id                    Int      @id @default(1)
  companyName           String   @default("DemandFlow Scheduler") @map("company_name") @db.VarChar(150)
  schedulingTimezone    String   @default("America/New_York") @map("scheduling_timezone") @db.VarChar(50)
  autoFederalHolidays   Boolean  @default(true) @map("auto_federal_holidays")
  minAdvanceHours       Int      @default(2) @map("min_advance_hours")
  maxAdvanceDays        Int      @default(60) @map("max_advance_days")
  prospectEmailRequired Boolean  @default(true) @map("prospect_email_required")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("calendar_settings")
}

model WorkingHours {
  id           Int      @id @default(autoincrement())
  dayOfWeek    Int      @unique @map("day_of_week") // 1 = Monday ... 7 = Sunday
  dayName      String   @map("day_name") @db.VarChar(20)
  isWorkingDay Boolean  @default(true) @map("is_working_day")
  startTime    String   @default("09:00") @map("start_time") @db.VarChar(10)
  endTime      String   @default("17:00") @map("end_time") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("working_hours")
}

model SlotSettings {
  id                     Int      @id @default(1)
  meetingDurationMinutes Int      @default(20) @map("meeting_duration_minutes")
  slotsPerHour           Int      @default(3) @map("slots_per_hour")
  bufferMinutes          Int      @default(0) @map("buffer_minutes")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("slot_settings")
}

model Holiday {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  holidayDate DateTime @map("holiday_date") @db.Date
  isFederal   Boolean  @default(false) @map("is_federal")
  isRecurring Boolean  @default(false) @map("is_recurring")
  isPartial   Boolean  @default(false) @map("is_partial")
  startTime   String?  @map("start_time") @db.VarChar(10)
  endTime     String?  @map("end_time") @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([holidayDate])
  @@map("holidays")
}

model CalendarException {
  id              Int      @id @default(autoincrement())
  exceptionDate   DateTime @unique @map("exception_date") @db.Date
  isBlocked       Boolean  @default(true) @map("is_blocked")
  customStartTime String?  @map("custom_start_time") @db.VarChar(10)
  customEndTime   String?  @map("custom_end_time") @db.VarChar(10)
  reason          String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("calendar_exceptions")
}

model Booking {
  id                 Int            @id @default(autoincrement())
  bookingReference   String         @unique @map("booking_reference") @db.VarChar(50)
  agentId            Int?           @map("agent_id")
  bookingLinkId      Int?           @map("booking_link_id")
  agentName          String         @map("agent_name") @db.VarChar(100)
  agentEmail         String?        @map("agent_email") @db.VarChar(191)
  prospectName       String?        @map("prospect_name") @db.VarChar(100)
  prospectEmail      String?        @map("prospect_email") @db.VarChar(191)
  companyName        String?        @map("company_name") @db.VarChar(150)
  meetingPurpose     String?        @map("meeting_purpose") @db.VarChar(255)
  meetingNotes       String?        @map("meeting_notes") @db.Text
  slotStartUtc       DateTime       @map("slot_start_utc")
  slotEndUtc         DateTime       @map("slot_end_utc")
  bookedTimezone     String         @map("booked_timezone") @db.VarChar(50)
  status             String         @default("CONFIRMED") @db.VarChar(30)
  cancellationReason String?        @map("cancellation_reason") @db.Text
  rescheduledFromId  Int?           @map("rescheduled_from_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  
  agent              Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  bookingLink        BookingLink?   @relation(fields: [bookingLinkId], references: [id], onDelete: SetNull)
  rescheduledFrom    Booking?       @relation("RescheduledBookings", fields: [rescheduledFromId], references: [id])
  rescheduledTo      Booking[]      @relation("RescheduledBookings")
  slotAllocation     SlotInventory?

  @@index([slotStartUtc])
  @@index([status])
  @@index([agentId])
  @@index([agentEmail])
  @@index([prospectEmail])
  @@map("bookings")
}

model SlotInventory {
  id           Int      @id @default(autoincrement())
  slotStartUtc DateTime @unique @map("slot_start_utc")
  bookingId    Int      @unique @map("booking_id")
  status       String   @default("BOOKED") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("slot_inventory")
}

model BookingField {
  id         Int      @id @default(autoincrement())
  fieldName  String   @unique @map("field_name") @db.VarChar(50)
  fieldLabel String   @map("field_label") @db.VarChar(100)
  fieldType  String   @default("text") @map("field_type") @db.VarChar(30)
  isRequired Boolean  @default(true) @map("is_required")
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")

  @@map("booking_fields")
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?     @map("admin_id")
  actionType String   @map("action_type") @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(50)
  details    String?  @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([actionType])
  @@index([createdAt])
  @@map("activity_logs")
}
