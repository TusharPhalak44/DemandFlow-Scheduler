{
  "name": "demandflow-scheduler",
  "version": "1.0.0",
  "description": "DemandFlow Scheduler - Meeting Calendar Booking & Management System",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "prisma:generate": "prisma generate",
    "build:server": "npm --prefix server run build && prisma generate",
    "build:client": "npm --prefix client run build && node -e \"import('fs').then(fs => fs.cpSync('client/dist', 'dist', {recursive: true}));\"",
    "build": "npm run build:server && npm run build:client",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\""
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ics": "^3.8.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true
  }
}
